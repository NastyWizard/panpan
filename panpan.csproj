<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GlmSharp" Version="0.9.8" />
    <PackageReference Include="SDL3-CS" Version="3.2.24" />
    <PackageReference Include="SDL3-CS.Native" Version="3.2.24" />
    <PackageReference Include="SDL3-CS.Native.Image" Version="3.2.4" />
    <PackageReference Include="SDL3-CS.Native.Mixer" Version="2.8.1.1" />
    <PackageReference Include="SDL3-CS.Native.TTF" Version="3.2.2" />
    <Content Include="thirdparty/osx/**" Condition=" '$(OS)' != 'Windows_NT' ">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="thirdparty/win64/**" Condition=" '$(OS)' == 'Windows_NT' ">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="ruby ./embed_assets.rb" />
  </Target>

</Project>
